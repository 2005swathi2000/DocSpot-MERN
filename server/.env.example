# ==============================================================================
# DocSpot-MERN Server Environment Configuration Example
# Copy this file to server/.env and adjust variables as needed for local execution.
# ==============================================================================

# Server Network Configuration (Default harmonized port: 5000)
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/docspot_db
# Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/docspot_db?retryWrites=true&w=majority
DATABASE=mongodb://localhost:27017/docspot_db

# JWT Cryptographic Secret (Minimum 32 characters recommended for production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=90d
